        "displayName": "Transform Commuters Into Giant Ants",
        "postRandomization": {
          "notes": [
            "Twists equal to the number of players plus 6."
          ],
          "conditionalRules": [
            {
              "parameter": "numberOfPlayers",
              "conditions": {
                "1": {
                  "schemeTwists": 7
                },
                "2": {
                  "schemeTwists": 8
                },
                "3": {
                  "schemeTwists": 9
                },
                "4": {
                  "schemeTwists": 10
                },
                "5": {
                  "schemeTwists": 11
                }
              }
            }
          ]
        }
      },
      {
        "name": "Trap_Heroes_in_the_Microverse",
        "displayName": "Trap Heroes In The Microverse",
        "postRandomization": {
          "schemeTwists": 11,
          "dynamicNotes": [
            {
              "template": "Add all 14 cards for an extra Hero to the Villain Deck. ({extraHero})",
              "variables": {
                "extraHero": {
                  "type": "randomUnusedElementOfType",
                  "elementType": "heroes"
                }
              }
            }
          ]
        }
      }
    ]
